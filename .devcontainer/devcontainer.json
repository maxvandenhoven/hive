{
    "name": "hive",
    "dockerComposeFile": "docker-compose.yaml",
    "service": "devcontainer",
    "shutdownAction": "stopCompose",
    "workspaceFolder": "/workspaces/hive",
    "postStartCommand": "make install-pre-commit && make sync",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-toolsai.jupyter",
                "johnpapa.vscode-peacock",
                "charliermarsh.ruff",
                "astral-sh.ty",
                "Weidav.uv-auto-venv"
            ],
            "settings": {
                "python.terminal.activateEnvironment": false,
                "python.createEnvironment.contentButton": "hide",
                "python.useEnvironmentsExtension": false,
                "ty.inlayHints.callArgumentNames": false,
                "ty.inlayHints.variableTypes": false,
                "ty.completions.autoImport": false
            }
        }
    }
}
