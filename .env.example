# Settings of the API service for local development, matching `deploy/compose.yaml`.
# `make dev` copies this file to `.env` (git-ignored) if it does not exist yet.
HIVE_DATABASE_URL=postgresql+psycopg://hive:hive@localhost:5432/hive
HIVE_S3_ENDPOINT_URL=http://localhost:3900
HIVE_S3_REGION=garage
HIVE_S3_BUCKET=hive
HIVE_S3_ACCESS_KEY_ID=GK0123456789abcdef01234567
HIVE_S3_SECRET_ACCESS_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
HIVE_LOG_LEVEL=INFO
